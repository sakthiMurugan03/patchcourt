# ── PatchCourt configuration ──────────────────────────────────────────────
# Copy to .env and fill in secrets. PatchCourt runs fully offline with no
# keys (mock LLM + synthetic scanner); every variable below is optional.

# GitHub API token (higher rate limits, private repos). Optional for public.
GITHUB_TOKEN=

# ── LLM provider ──────────────────────────────────────────────────────────
# mock | openai | claude | gemini | ollama   (default: mock)
LLM_PROVIDER=mock
# Key for openai / claude / gemini. Not needed for mock or ollama.
LLM_API_KEY=
# OpenAI-compatible base URL (also used for Ollama's /v1 endpoint).
LLM_BASE_URL=https://api.openai.com/v1
# e.g. gpt-4o, claude-3-5-sonnet-latest, gemini-flash-latest, llama3.1
LLM_MODEL=gpt-4o
# Force the deterministic mock regardless of provider (1/true).
USE_MOCK_LLM=false

# ── Evidence engine / tools ───────────────────────────────────────────────
# Comma-separated adapters: semgrep,bandit,gitleaks,radon,synthetic
PATCHCOURT_TOOLS=semgrep,bandit,gitleaks,radon
# Add the offline fake scanner that flags shell=True/SQL concat/secrets (1/true).
USE_SYNTHETIC_TOOLS=false

# ── Sandbox (run tools inside Docker for untrusted code) ──────────────────
SANDBOX_ENABLED=false
SANDBOX_IMAGE=patchcourt-sandbox:latest
SANDBOX_WORKSPACE=/workspace

# ── Vector store (Qdrant) ─────────────────────────────────────────────────
# Leave empty for an in-memory store (tests, quick demos).
QDRANT_URL=
QDRANT_COLLECTION=patchcourt_chunks

# ── Async queue + audit DB ────────────────────────────────────────────────
# Celery broker, e.g. redis://localhost:6379/0 (leave empty to disable).
REDIS_URL=
# SQLAlchemy URL for the PostgreSQL audit trail (leave empty to disable).
DATABASE_URL=

# ── SonarQube baseline (stage 8) ──────────────────────────────────────────
# Leave SONAR_URL unset (not just blank): the CLI defaults to
# http://localhost:9000 (host-correct) while docker-compose.yml defaults the
# containerized api/worker to http://host.docker.internal:9000 (container-
# correct). Only set this if you need to override BOTH to a remote SonarQube.
# SONAR_URL=
SONAR_TOKEN=
SONAR_COMPONENT=patchcourt

# ── SonarQube Live (dashboard tab) ──────────────────────────────────────────
SONAR_PROJECT_KEY=patchcourt
SONAR_HOST_URL=http://localhost:9000